---
import BaseLayout from "../layouts/BaseLayout.astro";
import MobileMenu from "../components/MobileMenu";
import { Animated } from "../components/ScrollReveal";
---
<BaseLayout>
  <header class="h-16">
    <div class="mx-auto max-w-[1100px] px-5 h-full grid grid-cols-[auto_1fr_auto] items-center gap-4 relative">
      <a href="#" class="flex items-center gap-1 md:gap-2">
        <img src="/images/logo.png" alt="FerrumC" class="h-9 w-9 rounded logo-img" />
        <span class="text-sm font-bold">FerrumC</span>
        <span
          class="inline-flex items-center rounded-full bg-orange-600/90 px-2 py-[2px] text-[10px] uppercase tracking-wide leading-none shadow-sm ml-1"
          >experimental</span
        >
      </a>
      <nav class="hidden md:flex justify-start gap-3 ml-2 text-sm text-neutral-400">
        <a href="#features" class="hover:text-white">Features</a>
        <a href="/downloads" class="hover:text-white">Downloads</a>
        <a href="#blog" class="hover:text-white">Blog</a>
        <a href="https://docs.ferrumc.com/" class="hover:text-white">Documentation</a>
      </nav>
      <a
        class="hidden sm:inline-flex items-center rounded-lg bg-white/10 px-4 py-2 font-semibold hover:bg-white/15 justify-self-end"
        href="https://github.com/ferrumc-rs/ferrumc"
        >Contribute on GitHub</a
      >
      <MobileMenu client:load />
    </div>
  </header>

  <main>
    <section class="pt-12 pb-8 hero-bg min-h-[calc(100vh-4rem)] flex items-center">
      <div class="mx-auto max-w-[1100px] px-5 grid items-center gap-8 lg:gap-10 lg:grid-cols-[1fr_520px] xl:grid-cols-[1fr_620px] relative">
        <div>
          <Animated client:load delay={0.05}>
            <h1 class="m-0 text-xl md:text-3xl font-extrabold leading-tight">
              A <span class="text-orange-600 accent-shimmer">fully multi-threaded</span>
              Minecraft server<br />you didn't know you needed.
            </h1>
          </Animated>
          <Animated client:load delay={0.12}>
            <p class="text-neutral-400 mt-4 mb-5">
              Built in Rust, FerrumC makes servers feel fast, worlds stream in quickly, ticks stay smooth, and memory stays
              lean while staying compatible with vanilla clients.
            </p>
          </Animated>
          <Animated client:load delay={0.18}>
            <div class="flex gap-3 mb-4 justify-center md:justify-start">
            <a class="inline-flex items-center rounded-lg bg-orange-600 px-4 py-2 font-semibold hover:bg-orange-500 lift" href="/downloads"
              >Download</a
            >
            <a class="inline-flex items-center rounded-lg bg-white/10 px-4 py-2 font-semibold hover:bg-white/15 lift" href="https://github.com/ferrumc-rs/ferrumc"
              >View on GitHub</a
            >
            </div>
          </Animated>
        </div>
        <Animated client:load delay={0.1} className="flex justify-center order-first md:order-none hero-img-wrap lg:mr-[-40px] mt-4 md:mt-6 lg:mt-0">
          <img
            src="/images/in_game.png"
            alt="in-game"
            class="hero-img float-slow w-full max-w-[680px] md:max-w-[760px] lg:w-auto lg:max-w-[640px] rounded-2xl shadow-2xl ring-1 ring-white/10"
          />
        </Animated>
      </div>
    </section>

    <Animated client:load>
      <section class="bg-orange-600 text-white mt-9 py-14">
      <div class="mx-auto max-w-[1100px] px-5">
        <h2 class="text-center text-2xl font-semibold mb-6">Worlds that stream in fast, see it for yourself 👀</h2>
        <div class="flex justify-center">
          <img src="/images/chunk_loading.gif" alt="chunk loading gif" class="rounded-xl shadow-2xl w-[820px] max-w-full" />
        </div>
      </div>
      </section>
    </Animated>

    <Animated client:load>
      <section id="features" class="mx-auto max-w-[1100px] px-5 py-16 grid gap-9 md:grid-cols-[1fr_480px] items-center">
      <div>
        <img src="/images/in_game.png" alt="in-game screenshot" class="w-full rounded-2xl" />
      </div>
      <div>
        <h3 class="text-2xl font-semibold mb-3">
          Engineered for throughput.<br /><span class="text-orange-600">Parallel by design.</span>
        </h3>
        <ul class="list-disc pl-5 text-neutral-400 space-y-2 mb-6">
          <li>Parallel engine with a thread-safe architecture</li>
          <li>High performance and memory efficiency</li>
          <li>Customizable server list</li>
          <li>World importing from vanilla Minecraft</li>
          <li>Powerful Entity Component System</li>
          <li>Lightning-fast world loading</li>
          <li>Compatible with vanilla Minecraft clients (1.20.1)</li>
        </ul>
        <a class="inline-flex items-center rounded-lg bg-orange-600 px-4 py-2 font-semibold hover:bg-orange-500" href="/downloads">Download</a>
      </div>
      </section>
    </Animated>

    <Animated client:load>
      <section class="mx-auto max-w-[1100px] px-5 pb-12">
      <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
        <h3 class="text-center text-xl font-semibold mb-4">Customizable server list</h3>
        <img src="/images/server-list.png" alt="server list" width="771" height="155" class="mx-auto rounded-xl shadow-2xl max-w-full" />
      </div>
      </section>
    </Animated>

    <section class="mx-auto max-w-[1100px] px-5 py-16 text-center">
      <h2 class="text-3xl font-extrabold">Want to start contributing?</h2>
      <p class="text-orange-600 text-3xl font-extrabold mt-1 mb-5">Check us out on GitHub</p>
      <a id="github" class="inline-flex items-center rounded-xl bg-white/10 px-5 py-3 font-semibold hover:bg-white/15" href="https://github.com/ferrumc-rs/ferrumc" target="_blank" rel="noreferrer"
        >View on GitHub</a
      >
    </section>
  </main>

  <footer class="border-t border-white/10 mt-6 py-5">
    <div class="mx-auto max-w-[1100px] px-5 flex items-center justify-between text-neutral-400 text-sm">
      <div>© 2025 FerrumC</div>
      <div class="space-x-3">
        <a class="hover:text-white" href="#">Privacy</a>
        <a class="hover:text-white" href="#">Terms</a>
      </div>
    </div>
  </footer>
</BaseLayout>
